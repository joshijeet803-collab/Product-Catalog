@{
    ViewBag.Title = "Contact";
}

<style>
    .contact-page {
        min-height: 72vh;
        padding: 70px 20px;
        background: linear-gradient(135deg, #eef7ff, #ffffff);
    }

    .contact-box {
        max-width: 950px;
        margin: auto;
        padding: 55px;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 18px 50px rgba(15, 40, 70, 0.12);
        text-align: center;
    }

    .contact-tag {
        color: #1683d8;
        font-size: 13px;
        font-weight: bold;
        letter-spacing: 3px;
        margin-bottom: 12px;
    }

    .contact-box h1 {
        margin: 0;
        font-size: 42px;
        color: #102a43;
    }

    .contact-intro {
        margin: 15px auto 40px;
        max-width: 650px;
        color: #60758a;
        font-size: 17px;
    }

    .contact-cards {
        display: flex;
        gap: 22px;
    }

    .contact-card {
        flex: 1;
        padding: 30px 20px;
        background: #f6fbff;
        border: 1px solid #dfedf8;
        border-radius: 18px;
    }

    .contact-icon {
        font-size: 30px;
        margin-bottom: 12px;
    }

    .contact-card h3 {
        margin: 8px 0;
        color: #102a43;
        font-size: 21px;
    }

    .contact-card p {
        margin: 0;
        color: #60758a;
        font-size: 15px;
    }

    @@media(max-width:700px) {
        .contact-box {
            padding: 30px 20px;
        }

        .contact-cards {
            flex-direction: column;
        }
    }
</style>

<div class="contact-page">

    <div class="contact-box">

        <div class="contact-tag">GET IN TOUCH</div>

        <h1>Contact Us</h1>

        <p class="contact-intro">
            Have a question about our Product Catalog?
            We would be happy to hear from you.
        </p>

        <div class="contact-cards">

            <div class="contact-card">
                <div class="contact-icon">📞</div>
                <h3>Phone</h3>
                <p>1234567891</p>
            </div>

            <div class="contact-card">
                <div class="contact-icon">✉️</div>
                <h3>Email</h3>
                <p>jeetJoshi@gmail.com</p>
            </div>

            <div class="contact-card">
                <div class="contact-icon">📍</div>
                <h3>Location</h3>
                <p>Marwadi University</p>
            </div>

        </div>

    </div>

</div>