@{
    ViewBag.Title = "About";
}

<style>
    .about-page {
        min-height: 70vh;
        padding: 70px 20px;
        background: linear-gradient(135deg, #eef7ff, #ffffff);
    }

    .about-box {
        max-width: 950px;
        margin: auto;
        background: white;
        padding: 55px;
        border-radius: 24px;
        box-shadow: 0 15px 45px rgba(20, 45, 80, 0.12);
        text-align: center;
    }

    .about-tag {
        color: #1683d8;
        font-size: 13px;
        font-weight: bold;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .about-box h1 {
        margin: 15px 0;
        font-size: 42px;
        color: #102a43;
    }

    .about-box p {
        color: #60758a;
        font-size: 17px;
        line-height: 1.8;
    }

    .about-cards {
        display: flex;
        gap: 20px;
        margin-top: 35px;
        justify-content: center;
    }

    .about-card {
        flex: 1;
        padding: 25px;
        border-radius: 18px;
        background: #f5faff;
        border: 1px solid #e0edf8;
    }

        .about-card h3 {
            color: #102a43;
            margin-bottom: 10px;
        }

        .about-card span {
            font-size: 30px;
        }

    @@media(max-width:700px) {
        .about-cards {
            flex-direction: column;
        }

        .about-box {
            padding: 30px;
        }
    }
</style>

<div class="about-page">
    <div class="about-box">

        <div class="about-tag">ABOUT PRODUCT CATALOG</div>

        <h1>Simple. Modern. Premium.</h1>

        <p>
            ProductCatalog is a clean ASP.NET MVC application
            designed to display products in a simple and modern way.
            It demonstrates the use of Models, Views and Controllers
            with a user-friendly interface.
        </p>

        <div class="about-cards">

            <div class="about-card">
                <span>💻</span>
                <h3>Modern Products</h3>
                <p>Explore a collection of selected technology products.</p>
            </div>

            <div class="about-card">
                <span>⚡</span>
                <h3>Easy Experience</h3>
                <p>Simple navigation with a clean and responsive design.</p>
            </div>

            <div class="about-card">
                <span>🛡️</span>
                <h3>ASP.NET MVC</h3>
                <p>Built using C# and ASP.NET MVC architecture.</p>
            </div>

        </div>

    </div>
</div>