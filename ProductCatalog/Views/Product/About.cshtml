@{
    ViewBag.Title = "About";
}

<style>
    body {
        margin: 0;
        background: #f4f7fb;
        font-family: Arial, sans-serif;
        color: #172033;
    }

    .about {
        max-width: 900px;
        margin: 70px auto;
        padding: 20px;
    }

    .box {
        background: white;
        padding: 55px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0,0,0,.08);
    }

    .tag {
        color: #2563eb;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 2px;
    }

    h1 {
        font-size: 40px;
        margin: 15px 0;
    }

    p {
        color: #64748b;
        line-height: 1.7;
        font-size: 16px;
    }

    .features {
        display: flex;
        justify-content: center;
        gap: 18px;
        margin-top: 35px;
        flex-wrap: wrap;
    }

    .feature {
        width: 190px;
        padding: 22px;
        background: #f4f7fb;
        border-radius: 14px;
    }

        .feature h3 {
            margin: 8px 0;
        }

        .feature p {
            font-size: 13px;
            margin: 0;
        }
</style>

<div class="about">

    <div class="box">

        <div class="tag">ABOUT PRODUCT CATALOG</div>

        <h1>Simple. Modern. Reliable.</h1>

        <p>
            Product Catalog is an ASP.NET MVC application designed
            to display products in a clean and modern interface.
            It demonstrates the use of Models, Controllers, Views
            and Routing in MVC architecture.
        </p>

        <div class="features">

            <div class="feature">
                <h3>📦 Products</h3>
                <p>Organized product information.</p>
            </div>

            <div class="feature">
                <h3>⚙ MVC</h3>
                <p>Clean Model View Controller structure.</p>
            </div>

            <div class="feature">
                <h3>✨ Modern UI</h3>
                <p>Simple and premium interface.</p>
            </div>

        </div>

    </div>

</div>