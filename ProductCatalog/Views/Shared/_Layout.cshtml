<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ProductCatalog</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f8fc;
            color: #102a43;
        }

        .navbar {
            height: 72px;
            background: #0b1728;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8%;
            box-shadow: 0 4px 20px rgba(0,0,0,.15);
        }

        .brand {
            color: white;
            font-size: 22px;
            font-weight: bold;
            text-decoration: none;
        }

            .brand span {
                color: #38bdf8;
            }

        .nav-links {
            display: flex;
            gap: 30px;
        }

            .nav-links a {
                color: #dbeafe;
                text-decoration: none;
                font-size: 15px;
                transition: .2s;
            }

                .nav-links a:hover {
                    color: #38bdf8;
                }

        .main-content {
            min-height: calc(100vh - 132px);
        }

        .footer {
            padding: 25px 8%;
            background: #0b1728;
            color: #9fb3c8;
            font-size: 14px;
        }

        @@media(max-width:700px) {
            .navbar {
                padding: 0 5%;
            }

            .nav-links {
                gap: 12px;
            }

                .nav-links a {
                    font-size: 13px;
                }
        }
    </style>
</head>

<body>

    <nav class="navbar">

        <a href="@Url.Action("Index", "Product")" class="brand">
            Product<span>Catalog</span>
        </a>

        <div class="nav-links">
            <a href="@Url.Action("Index", "Product")">Products</a>
            <a href="@Url.Action("About", "Home")">About</a>
            <a href="@Url.Action("Contact", "Home")">Contact</a>
        </div>

    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        © 2026 ProductCatalog · ASP.NET MVC · C#
    </footer>

</body>
</html>